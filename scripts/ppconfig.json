{"name":"bccfddbdf","url":"index.html (等资源+1)","showName":"国标码转换V1","appid":"com.bccfddbdf.pakeplus","icon":"","iconPath":"C:\\Users\\WEICC\\AppData\\Roaming\\com.pakeplus.pacbao\\ljnjbg1hu1h.png","iconRound":true,"state":true,"single":true,"injectJq":true,"tauriApi":false,"devbug":false,"version":"1.0.0","preview":"Android","platform":["1-1","2-2"],"width":412,"height":915,"desc":"","jsFile":[],"filterCss":"","customJs":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n<title>GBK双向转换</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,SimSun}\nbody{padding:16px;background:#fff;font-size:16px}\nh2{text-align:center;margin-bottom:14px;font-size:18px}\n.radio-group{margin-bottom:12px;text-align:center}\n.radio-group label{margin:0 8px;font-size:15px;cursor:pointer}\n#inputBox{width:100%;padding:10px 8px;font-size:16px;border:1px solid #aaa;border-radius:6px;margin-bottom:10px}\n.btn-group{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}\nbutton{padding:10px;border:none;border-radius:6px;background:#4078c0;color:#fff;font-size:15px}\nbutton:active{background:#2b5994}\n#resultBox{width:100%;min-height:260px;border:1px solid #ddd;padding:10px;white-space:pre-wrap;overflow-y:auto;font-size:15px;background:#fafafa;border-radius:6px}\ninput[type=\"file\"]{display:none}\n</style>\n</head>\n<body>\n<h2>GBK双向转换工具</h2>\n<div class=\"radio-group\">\n  <label><input type=\"radio\" name=\"mode\" value=\"gbk2han\" checked> GBK→汉字</label>\n  <label><input type=\"radio\" name=\"mode\" value=\"han2gbk\"> 汉字→GBK</label>\n</div>\n<input id=\"inputBox\" type=\"text\" placeholder=\"输入内容，点转换，支持回车\">\n<div class=\"btn-group\">\n  <button onclick=\"convert()\">转换</button>\n  <button onclick=\"document.getElementById('fileInput').click()\">读取TXT</button>\n  <button onclick=\"clearResult()\">清空记录</button>\n  <button onclick=\"exportTxt()\">导出TXT</button>\n</div>\n<input type=\"file\" id=\"fileInput\" accept=\".txt\" onchange=\"loadTxt(this)\">\n<div id=\"resultBox\"></div>\n\n<script>\nconst resultBox = document.getElementById('resultBox');\nconst inputBox = document.getElementById('inputBox');\n\n// 【关键】GBK解码器，兼容所有安卓浏览器\nconst gbkDecode = function(hexStr){\n  try{\n    hexStr = hexStr.replace(/\\s/g,'');\n    if(hexStr.length %2 !==0) return \"❌转换失败\";\n    const bytes = [];\n    for(let i=0;i<hexStr.length;i+=2){\n      bytes.push(parseInt(hexStr.substr(i,2),16));\n    }\n    const u8 = new Uint8Array(bytes);\n    return new TextDecoder('gbk').decode(u8);\n  }catch(e){return \"❌转换失败\";}\n}\n\n// 汉字转GBK 稳定方案（用TextEncoder+转码垫片，安卓兼容）\nfunction charToGBKHex(str){\n  try{\n    const b = new Blob([str],{type:\"text/plain;charset=gbk\"});\n    const fr = new FileReader();\n    return new Promise((res,rej)=>{\n      fr.onload = ()=>{\n        const arr = new Uint8Array(fr.result);\n        let s = \"\";\n        arr.forEach(x=>s+=x.toString(16).padStart(2,'0'));\n        res(s.toUpperCase());\n      }\n      fr.onerror=()=>rej();\n      fr.readAsArrayBuffer(b);\n    })\n  }catch(e){return Promise.resolve(\"❌转换失败\");}\n}\n\nasync function convert(){\n  const mode = document.querySelector('input[name=\"mode\"]:checked').value;\n  const s = inputBox.value.trim();\n  if(!s){alert(\"请输入内容\");return;}\n  let ret;\n  if(mode === \"gbk2han\"){\n    ret = gbkDecode(s);\n  }else{\n    ret = await charToGBKHex(s);\n  }\n  resultBox.innerText += `${s} → ${ret}\\n`;\n  resultBox.scrollTop = resultBox.scrollHeight;\n}\n\n// 回车触发\ninputBox.addEventListener('keydown',e=>{\n  if(e.key === \"Enter\") convert();\n})\n\n// 读取txt批量\nasync function loadTxt(el){\n  const f = el.files[0];\n  if(!f) return;\n  const mode = document.querySelector('input[name=\"mode\"]:checked').value;\n  const r = new FileReader();\n  r.onload = async ev=>{\n    const lines = ev.target.result.split('\\n');\n    let out = \"\";\n    for(let line of lines){\n      const s = line.trim();\n      if(!s) continue;\n      let res;\n      if(mode==\"gbk2han\") res = gbkDecode(s);\n      else res = await charToGBKHex(s);\n      out += `${s} → ${res}\\n`;\n    }\n    resultBox.innerText += out;\n    resultBox.scrollTop = resultBox.scrollHeight;\n  }\n  r.readAsText(f);\n  el.value = \"\";\n}\n\nfunction clearResult(){\n  resultBox.innerText = \"\";\n}\nfunction exportTxt(){\n  const txt = resultBox.innerText;\n  if(!txt.trim()){alert(\"没有结果\");return;}\n  const blob = new Blob([txt],{type:\"text/plain;charset=utf-8\"});\n  const a = document.createElement(\"a\");\n  a.href = URL.createObjectURL(blob);\n  a.download = \"gbk转换结果.txt\";\n  a.click();\n  URL.revokeObjectURL(a.href);\n}\n</script>\n</body>\n</html>\n","isHtml":true,"htmlPath":"C:\\Users\\WEICC\\Desktop\\99996","htmlFiles":[],"prefix":"","pcRepo":"PakePlus","iosRepo":"PakePlus-iOS","androidRepo":"PakePlus-Android","win7Repo":"","versionStr":"web10","more":{"windows":{"label":"bccfddbdf","title":"国标码转换V1","url":"index.html (等资源+1)","userAgent":"Mozilla/5.0 (Linux; Android 14; Pixel 6) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36","width":412,"height":915,"theme":null,"resizable":true,"fullscreen":false,"maximized":false,"minWidth":400,"minHeight":300,"maxWidth":1920,"maxHeight":1080,"decorations":true,"transparent":false,"titleBarStyle":"Visible","visible":true,"focus":true,"closable":true,"minimizable":true,"maximizable":true,"alwaysOnTop":false,"alwaysOnBottom":false,"center":false,"shadow":true,"skipTaskbar":false,"tabbingIdentifier":null,"parent":null,"dragDropEnabled":true,"browserExtensionsEnabled":false,"devtools":true,"contentProtected":false,"hiddenTitle":false,"incognito":false,"proxyUrl":null,"useHttpsScheme":false,"zoomHotkeysEnabled":false,"acceptFirstMouse":false,"create":false,"backgroundColor":null,"backgroundThrottling":null,"javascriptDisabled":false}},"phone":{"fullScreen":fa